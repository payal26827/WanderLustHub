<% layout("layouts/boilerplate", { title: "Edit Listing" }) -%>

<h1>Edit Listing</h1>

<form action="/listings/<%= listing._id %>?_method=PUT" method="POST" enctype="multipart/form-data" class="form">
  <label>Title</label>
  <input name="listing[title]" value="<%= listing.title %>" required>

  <label>Description</label>
  <textarea name="listing[description]" required><%= listing.description %></textarea>

  <label>Price</label>
  <input type="number" name="listing[price]" value="<%= listing.price %>" min="0" required>

  <label>Location</label>
  <input name="listing[location]" value="<%= listing.location %>" required>

  <label>Country</label>
  <input name="listing[country]" value="<%= listing.country %>" required>

  <label>Category</label>
  <select name="listing[category]" required>
    <% ["Trending","Rooms","Mountains","Arctic","Camping","Beach","City","Farms"].forEach(cat => { %>
      <option <%= listing.category === cat ? "selected" : "" %>><%= cat %></option>
    <% }) %>
  </select>

  <p>Current image:</p>
  <% if (listing.image?.url) { %>
    <img class="edit-image" src="<%= listing.image.url %>" alt="Current listing image">
  <% } %>

  <label>Replace image (optional)</label>
  <input id="imageInput" type="file" name="image" accept="image/*">
  <img id="imagePreview" class="preview hidden" alt="New image preview">

  <button type="submit">Save Changes</button>
</form>
