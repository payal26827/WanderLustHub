<% layout("layouts/boilerplate", { title: listing.title }) -%>

<div class="show-grid">
  <section>
    <img
      class="show-image"
      src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85?auto=format&fit=crop&w=1200&q=80' %>"
      alt="<%= listing.title %>"
    >

    <div class="show-content">
      <span class="badge"><%= listing.category %></span>

      <h1><%= listing.title %></h1>

      <p><%= listing.description %></p>

      <p>
        <strong>
          ₹<%= listing.price.toLocaleString("en-IN") %>
        </strong>
        / night
      </p>

      <p>
        📍 <%= listing.location %>, <%= listing.country %>
      </p>

      <p>
        Owner: <%= listing.owner?.username || "Unknown" %>
      </p>

      <% if (currentUser && String(listing.owner?._id) === String(currentUser)) { %>

        <div class="actions">
          <a
            class="button"
            href="/listings/<%= listing._id %>/edit"
          >
            Edit
          </a>

          <form
            action="/listings/<%= listing._id %>?_method=DELETE"
            method="POST"
            class="inline"
          >
            <button
              class="danger"
              type="submit"
              onclick="return confirm('Delete this listing?')"
            >
              Delete
            </button>
          </form>
        </div>

      <% } %>
    </div>
  </section>

  <section>
    <h2>Location</h2>
    <div id="map"></div>
  </section>
</div>

<hr>

<section>
  <h2>Reviews</h2>

  <% if (currentUser) { %>

    <form
      action="/listings/<%= listing._id %>/reviews"
      method="POST"
      class="form"
    >
      <label>Rating</label>

      <select
        name="review[rating]"
        required
      >
        <option value="5">★★★★★</option>
        <option value="4">★★★★☆</option>
        <option value="3">★★★☆☆</option>
        <option value="2">★★☆☆☆</option>
        <option value="1">★☆☆☆☆</option>
      </select>

      <label>Comment</label>

      <textarea
        name="review[comment]"
        required
        minlength="2"
      ></textarea>

      <button type="submit">
        Submit Review
      </button>
    </form>

  <% } else { %>

    <p>
      <a href="/login">Login</a>
      to write a review.
    </p>

  <% } %>

  <div class="reviews">

    <% listing.reviews.forEach(review => { %>

      <article class="review">

        <div class="stars">
          <%= "★".repeat(review.rating) %><%= "☆".repeat(5 - review.rating) %>
        </div>

        <p>
          <strong>
            <%= review.author?.username || "User" %>
          </strong>
        </p>

        <p>
          <%= review.comment %>
        </p>

        <% if (currentUser && String(review.author?._id) === String(currentUser)) { %>

          <form
            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
            method="POST"
          >
            <button
              class="danger small"
              type="submit"
            >
              Delete Review
            </button>
          </form>

        <% } %>

      </article>

    <% }) %>

  </div>
</section>

<script>
  window.listingMapData = {
    token: '<%= process.env.MAPBOX_TOKEN || "" %>',

    coordinates: <%- JSON.stringify(
      listing.geometry?.coordinates || [77.2090, 28.6139]
    ) %>,

    title: <%- JSON.stringify(listing.title) %>
  };
</script>